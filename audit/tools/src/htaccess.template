# ============================================================
# Barrana.ai - Apache / LiteSpeed (Hostinger) configuration
# Generated by _tools/build.mjs from _tools/src/htaccess.template
# ============================================================

Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404/index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# -- Canonical host and protocol --------------------------------
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://barrana.ai%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.barrana\.ai$ [NC]
RewriteRule ^ https://barrana.ai%{REQUEST_URI} [R=301,L]

# -- Audit task 1: retired duplicate resource URLs (one 301 hop, query string kept)
__REDIRECT_RULES__

# -- /index.html and /path/index.html -> clean URL ------------------
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^ https://barrana.ai/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)/index\.html[\s?]
RewriteRule ^ https://barrana.ai/%1 [R=301,L]

# -- Remove trailing slash (canonical URLs have none) ----------------
RewriteRule ^(.+)/$ https://barrana.ai/$1 [R=301,L]

# -- Serve the pre-rendered page for each clean URL -----------------
RewriteCond %{REQUEST_URI} !^/404$
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# Anything that is not a real file falls through to ErrorDocument 404 (/404/index.html, status 404).
</IfModule>

# -- Headers (mirrors the headers served by the live site on 2026-10-15)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://connect.facebook.net https://www.facebook.com https://*.facebook.com; frame-src 'self' https://www.google.com https://calendly.com; upgrade-insecure-requests"

    # Content-hashed bundles never change -> cache for a year.
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "^meta-pixel\.js$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    # HTML must revalidate so deploys show immediately.
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "^(robots\.txt|sitemap\.xml)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
</IfModule>

# -- Block dot-files and sensitive file types --
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|log|sh|sql|bak|config|lock|ini)$">
    Require all denied
</FilesMatch>
